# ==========================================
# STAGING ENVIRONMENT CONFIGURATION (.env.staging.example)
# ==========================================

PORT=4000
NODE_ENV=production
# Staging Managed PostgreSQL (e.g. Aiven, RDS, or Cloud SQL) with SSL enabled
DATABASE_URL=postgresql://staging_user:STAGING_STRONG_PASSWORD@pg-staging.internal:5432/walker_pass_staging?sslmode=require

# JWT Secret (Min 32 random characters - injected from KMS / Secrets Manager)
JWT_SECRET=CHANGE_ME_STAGING_JWT_SECRET_AT_LEAST_32_BYTES_LONG
JWT_EXPIRES_IN=12h

# CORS & Frontend Origins
CORS_ORIGIN=https://staging.walkerpass.park.gov.in
NEXT_PUBLIC_API_URL=https://staging.walkerpass.park.gov.in

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# S3 Object Storage (Private Bucket)
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET=wpd-staging-private-documents
S3_ACCESS_KEY=STAGING_AWS_ACCESS_KEY
S3_SECRET_KEY=STAGING_AWS_SECRET_KEY
S3_USE_SSL=true

# Aadhaar Field-Level Cryptography (Stored in AWS Secrets Manager / KMS)
AADHAAR_MASTER_KEY=STAGING_256BIT_HEX_ENCRYPTION_MASTER_KEY_NEVER_HARDCODE
AADHAAR_HMAC_SECRET=STAGING_256BIT_HEX_HMAC_BLIND_INDEX_SECRET_KEY
AADHAAR_KEY_VERSION=v1

# Error & Performance Monitoring
SENTRY_DSN=https://staging_public_key@o0.ingest.sentry.io/staging_project_id
