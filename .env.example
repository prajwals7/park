# Environment Configuration for Walker Pass Desk

# API Configuration
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/walker_pass_desk?schema=public
JWT_SECRET=super_secret_production_ready_jwt_key_32_chars_min
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:3000
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# MinIO / S3 Object Storage Configuration
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=walker-pass-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_USE_SSL=false

# Aadhaar Field-Level Encryption Secrets (AES-256-GCM master key & HMAC secret)
AADHAAR_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AADHAAR_HMAC_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
AADHAAR_KEY_VERSION=v1

# Web Client Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="Walker Pass Desk"
