datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  COLLECTOR
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum PassStatus {
  ACTIVE
  EXPIRING
  EXPIRED
}

enum PaymentMode {
  CASH
  UPI
}

enum PaymentType {
  NEW
  RENEWAL
}

enum DocumentType {
  AADHAAR
  PASSPORT
  TICKET
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  phone        String
  role         Role        @default(COLLECTOR)
  status       UserStatus  @default(ACTIVE)
  passwordHash String
  totpSecret   String?     // Encrypted at rest
  failedLogins Int         @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  createdWalkers   Walker[]        @relation("WalkerCreator")
  deletedWalkers   Walker[]        @relation("WalkerDeleter")
  collectedPayments Payment[]      @relation("PaymentCollector")
  correctedPayments Payment[]      @relation("PaymentCorrector")
  uploadedDocuments Document[]     @relation("DocumentUploader")
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]

  @@map("users")
}

model Gate {
  id        String    @id @default(uuid())
  code      String    @unique // e.g. 'G2', 'GS', 'G9'
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  walkers   Walker[]
  payments  Payment[]

  @@map("gates")
}

model Walker {
  id            String       @id @default(uuid())
  passNo        String       @unique
  name          String
  phone         String
  gateId        String
  aadhaarLast4        String?
  aadhaarEncrypted    String?      // AES-256-GCM ciphertext + nonce + keyVersion
  aadhaarHash         String?      // Blind HMAC-SHA256 for duplicate checking
  notes               String?
  consentAt     DateTime?
  deletedAt     DateTime?
  deletedById   String?
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  gate          Gate         @relation(fields: [gateId], references: [id])
  createdBy     User         @relation("WalkerCreator", fields: [createdById], references: [id])
  deletedBy     User?        @relation("WalkerDeleter", fields: [deletedById], references: [id])

  passes        Pass[]
  payments      Payment[]
  documents     Document[]
  notifications NotificationLog[]

  @@index([phone])
  @@index([passNo])
  @@index([aadhaarHash])
  @@index([deletedAt])
  @@map("walkers")
}

model Pass {
  id          String      @id @default(uuid())
  walkerId    String
  startDate   DateTime
  expiryDate  DateTime
  status      PassStatus  @default(ACTIVE)
  createdAt   DateTime    @default(now())

  walker      Walker      @relation(fields: [walkerId], references: [id])
  payments    Payment[]

  @@index([expiryDate])
  @@index([walkerId, status])
  @@map("passes")
}

model Payment {
  id            String       @id @default(uuid())
  walkerId      String
  passId        String
  gateId        String
  collectedById String
  amountPaise   Int          // Rs 200 = 20000 paise
  mode          PaymentMode
  type          PaymentType  // NEW or RENEWAL
  receiptNo     String       @unique // Collector-entered physical receipt number
  ticketDocId   String?
  isCorrected   Boolean      @default(false)
  correctionReason String?
  correctedAt   DateTime?
  correctedById String?
  createdAt     DateTime     @default(now())

  walker        Walker       @relation(fields: [walkerId], references: [id])
  pass          Pass         @relation(fields: [passId], references: [id])
  gate          Gate         @relation(fields: [gateId], references: [id])
  collectedBy   User         @relation("PaymentCollector", fields: [collectedById], references: [id])
  correctedBy   User?        @relation("PaymentCorrector", fields: [correctedById], references: [id])
  ticketDoc     Document?    @relation("PaymentTicketDocument", fields: [ticketDocId], references: [id])

  documents     Document[]   @relation("PaymentDocuments")

  @@index([createdAt])
  @@index([gateId])
  @@index([walkerId])
  @@map("payments")
}

model Document {
  id           String       @id @default(uuid())
  walkerId     String
  paymentId    String?
  type         DocumentType // AADHAAR, PASSPORT, TICKET
  storageKey   String       // S3 key
  mimeType     String
  sizeBytes    Int
  checksum     String?      // SHA-256 hash of document
  uploadedById String
  createdAt    DateTime     @default(now())

  walker       Walker       @relation(fields: [walkerId], references: [id])
  payment      Payment?     @relation("PaymentDocuments", fields: [paymentId], references: [id])
  uploadedBy   User         @relation("DocumentUploader", fields: [uploadedById], references: [id])
  ticketPayments Payment[]  @relation("PaymentTicketDocument")

  @@index([walkerId])
  @@index([storageKey])
  @@map("documents")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String   // REGISTER_WALKER, RENEW_PASS, OVERRIDE_PHONE, SOFT_DELETE, RESTORE_WALKER, etc.
  entity    String   // Walker, Pass, Payment, User
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor     User     @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([actorId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model NotificationLog {
  id        String   @id @default(uuid())
  walkerId  String
  type      String   // EXPIRY_WARNING, RENEWAL_CONFIRMATION, WELCOME
  channel   String   // SMS, WHATSAPP
  recipient String   // Phone number
  status    String   // SENT, FAILED, DELIVERED
  payload   Json?
  sentAt    DateTime?
  createdAt DateTime @default(now())

  walker    Walker   @relation(fields: [walkerId], references: [id])

  @@index([walkerId])
  @@index([createdAt])
  @@map("notification_logs")
}
