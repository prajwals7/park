# ==========================================
# PRODUCTION ENVIRONMENT CONFIGURATION (.env.production.example)
# ==========================================

PORT=4000
NODE_ENV=production
# Production Managed PostgreSQL (High Availability Multi-AZ with automated backups)
DATABASE_URL=postgresql://prod_app_user:PROD_SECURE_PASSWORD@pg-cluster.prod.internal:5432/walker_pass_production?sslmode=require&connection_limit=50

# JWT Authentication
JWT_SECRET=PROD_SECURE_RANDOM_GENERATED_JWT_SECRET_KEY_MIN_32_BYTES
JWT_EXPIRES_IN=12h

# Strict CORS Allowlist
CORS_ORIGIN=https://walkerpass.park.gov.in
NEXT_PUBLIC_API_URL=https://walkerpass.park.gov.in

# Strict Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Production Document Vault (S3 / Compliant Private Storage)
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET=wpd-prod-private-documents
S3_ACCESS_KEY=PROD_IAM_USER_ACCESS_KEY
S3_SECRET_KEY=PROD_IAM_USER_SECRET_KEY
S3_USE_SSL=true

# Aadhaar Field-Level Cryptography (Root Master Key managed in AWS KMS / HSM)
# Must NEVER match development/staging keys. Minimum 256 bits (64 hex characters).
AADHAAR_MASTER_KEY=PROD_256BIT_HEX_MASTER_KEY_RETRIEVED_FROM_KMS_OR_ENV
AADHAAR_HMAC_SECRET=PROD_256BIT_HEX_HMAC_SECRET_RETRIEVED_FROM_KMS_OR_ENV
AADHAAR_KEY_VERSION=v1

# Sentry Error Monitoring & Uptime Alerts
SENTRY_DSN=https://prod_public_key@o0.ingest.sentry.io/prod_project_id
